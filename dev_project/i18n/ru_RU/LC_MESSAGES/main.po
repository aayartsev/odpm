msgid ""
msgstr ""
"Project-Id-Version: odpm\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ru_RU\n"

msgid " \"config.json\" is deprecated. Please read documentation"
msgstr " Файл с параметрами \"config.json\" является устаревшим. Пожалуйста обратитесь к документации "

msgid "--build-image is only allowed when ODPM_SCENARIO=ci in .env"
msgstr "--build-image доступен только при ODPM_SCENARIO=ci в .env"

msgid "Accepted database drift: {KIND}"
msgstr "Принят дрейф конфигурации БД: {KIND}"

msgid "Adopting current database configuration as baseline (no last_run snapshot yet)."
msgstr "Принимаем текущую конфигурацию БД как baseline (снимок last_run ещё не создан)."

msgid "Application role {ROLE} present: {VALUE}"
msgstr "Роль приложения {ROLE} присутствует: {VALUE}"

msgid "Attached to container output. Detailed technical logs below are in English."
msgstr "Подключение к выводу контейнера. Подробные технические логи ниже — на английском."

msgid "Blocking database configuration drift detected; resolve before starting containers."
msgstr "Обнаружен блокирующий дрейф конфигурации БД; устраните его перед запуском контейнеров."

msgid "Blocking database configuration drift remains after resolution: {KINDS}"
msgstr "После разрешения дрейфа остаётся блокирующий дрейф конфигурации БД: {KINDS}"

msgid "Bootstrapping PostgreSQL application role {ROLE} in single-user mode."
msgstr "Создание роли приложения PostgreSQL {ROLE} в single-user режиме."

msgid "Cannot connect to the Docker daemon. Is the docker daemon running?"
msgstr "Не удалось выполнить подключение к службе Docker. Проверьте запущена ли она."

msgid "Cannot create dir, {dir_path}, please check it"
msgstr "Не удалось создать каталог, {dir_path}, пожалуйста проверьте его."

msgid "Cannot get docker-compose info, did you install it?"
msgstr "Не удалось получить информацию о Docker Compose. Проверьте установлен ли он."

msgid "Cannot list Docker containers: {DETAILS}"
msgstr "Не удалось получить список контейнеров Docker: {DETAILS}"

msgid "Canonical git pins: odpm.json locks.git; run --update-lock to refresh .odpm/deps.lock.json."
msgstr "Канонические git-пины: locks.git в odpm.json; выполните --update-lock, чтобы обновить .odpm/deps.lock.json."

msgid "Check `docker compose ps` and the English log output above for details."
msgstr "Проверьте `docker compose ps` и английский лог выше для подробностей."

msgid "Check database configuration drift against last_run snapshot"
msgstr "Проверить дрейф конфигурации БД относительно снимка last_run"

msgid "Checking out {REF} for {PROJECT}"
msgstr "Переключение на {REF} для {PROJECT}"

msgid "Compose service: {SERVICE}"
msgstr "Сервис compose: {SERVICE}"

msgid "Compose stack is healthy; reusing existing containers without --force-recreate"
msgstr "Стек compose в порядке; перезапуск без --force-recreate"

msgid "Configuration drift:"
msgstr "Дрейф конфигурации:"

msgid "Container start skipped (--skip-start)."
msgstr "Запуск контейнеров пропущен (--skip-start)."

msgid "Control+C pressed; stopping."
msgstr "Нажато Control+C; остановка."

msgid "Created PostgreSQL application role {ROLE}."
msgstr "Создана роль приложения PostgreSQL {ROLE}."

msgid "Created {ENV_FILE} from environment variables and defaults (non-interactive mode)."
msgstr "Создан файл {ENV_FILE} из переменных окружения и значений по умолчанию (неинтерактивный режим)."

msgid "Data path: {PATH}"
msgstr "Каталог данных: {PATH}"

msgid "Database configuration drift requires confirmation in non-interactive mode. Drift kinds: {KINDS}. Use --accept-database-drift=KIND for each accepted drift."
msgstr "Дрейф конфигурации БД требует подтверждения в неинтерактивном режиме. Типы дрейфа: {KINDS}. Используйте --accept-database-drift=KIND для каждого принятого дрейфа."

msgid "Database drift resolution aborted."
msgstr "Разрешение дрейфа конфигурации БД отменено."

msgid "Database status"
msgstr "Состояние базы данных"

msgid "Did you install git?"
msgstr "Вы установили git?"

msgid "Directory {START_DIR_PATH} is not a valid odpm project directory. Please run \"cd {PROJECT_PATH}\" to navigate to the correct location."
msgstr "Каталог {START_DIR_PATH} не является odpm катлогом, пожалуйста выполните команду cd {PROJECT_PATH} для перехода в нужный вам каталог"

msgid "Do not change this file, its content is generating automatically"
msgstr "Не изменяйте данный файл, его содержимое генерируется автоматически"

msgid "Do not change this param, it is generating automatically"
msgstr "Не изменяйте данный параметр, его значение генерируется автоматически"

msgid "Do not change, it will get from \"db_manager_password\" param from config.json file"
msgstr "Не изменяйте данный параметр, его значение будет взято из параметра \"db_manager_password\" файла конфигурации config.json"

msgid "Do you want to clone odoo? y/n\n"
msgstr "Вы хотите клонировать odoo? y/n\n"

msgid "Ensured PostgreSQL application role {ROLE} during baseline adoption."
msgstr "Роль приложения PostgreSQL {ROLE} создана при принятии baseline."

msgid "Environment variable {VAR} is not set (required for manifest field {FIELD})"
msgstr "Переменная окружения {VAR} не задана (нужна для поля manifest {FIELD})"

msgid "Error checking PostgreSQL port: {DETAIL}"
msgstr "Ошибка при проверке порта PostgreSQL: {DETAIL}"

msgid "Failed to bootstrap PostgreSQL application role {ROLE} in single-user mode."
msgstr "Не удалось создать роль приложения PostgreSQL {ROLE} в single-user режиме."

msgid "Failed to ensure PostgreSQL role {ROLE}."
msgstr "Не удалось создать или обновить роль PostgreSQL {ROLE}."

msgid "Failed to read nested {CONFIG_FILE_NAME} at {MANIFEST_PATH}: {ERROR}"
msgstr "Не удалось прочитать вложенный {CONFIG_FILE_NAME} ({MANIFEST_PATH}): {ERROR}"

msgid "Failed to start PostgreSQL service {SERVICE} for baseline adoption."
msgstr "Не удалось запустить сервис PostgreSQL {SERVICE} для принятия baseline."

msgid "File {SOURCE_FILE} with deprecated content was renamed to {DEPRECATED_FILE_NAME}"
msgstr "Файл {SOURCE_FILE} с устаревшим содержимым был переименован в {DEPRECATED_FILE_NAME}"

msgid "Git dependency lock updated; container start skipped."
msgstr "Git dependency lock обновлён; запуск контейнеров пропущен."

msgid "Git dependency {DEPENDENCY_URL} is not available locally; transitive entries from oca_dependencies.txt and nested odpm.json will be skipped"
msgstr "Git-зависимость {DEPENDENCY_URL} недоступна локально; транзитивные записи из oca_dependencies.txt и вложенного odpm.json будут пропущены"

msgid "Git lock source: .odpm/deps.lock.json; run --update-lock after changing dependencies."
msgstr "Источник git lock: .odpm/deps.lock.json; после смены зависимостей выполните --update-lock."

msgid "Git lock source: manifest locks.git in odpm.json (canonical); edit SHA in locks.git and run --update-lock to sync .odpm/deps.lock.json."
msgstr "Источник git lock: locks.git в odpm.json (канон); правьте SHA в locks.git и выполните --update-lock для синхронизации .odpm/deps.lock.json."

msgid "Host port: {PORT}"
msgstr "Порт на host: {PORT}"

msgid "If you want drop this file to default values, just delete it"
msgstr "Если вы хотите сбросить настройки этого файла в параметры по умолчанию, просто удалите его."

msgid "Invalid choice. Please enter one of: {CHOICES}"
msgstr "Неверный выбор. Введите один из вариантов: {CHOICES}"

msgid "Invalid manifest hook {PHASE}: empty command"
msgstr "Недопустимый manifest hook {PHASE}: пустая команда"

msgid "Invalid manifest hook {PHASE}: empty plugin id"
msgstr "Недопустимый manifest hook {PHASE}: пустой id плагина"

msgid "Invalid manifest hook {PHASE}: expected command argv or plugin id"
msgstr "Недопустимый manifest hook {PHASE}: ожидается argv команды или id плагина"

msgid "Invalid manifest_schema value {VALUE!r}; expected an integer."
msgstr "Недопустимое значение manifest_schema {VALUE!r}; ожидается целое число."

msgid "Invalid {FIELD} value {VALUE!r}; expected a semantic version (for example 4.4 or 4.4.0)."
msgstr "Недопустимое значение {FIELD} {VALUE!r}; ожидается семантическая версия (например 4.4 или 4.4.0)."

msgid "Invalid {LABEL} odpm.json at {PATH}: {DETAIL}"
msgstr "Недопустимый {LABEL} odpm.json в {PATH}: {DETAIL}"

msgid "Manifest at {PATH} is valid ({SCHEMA} JSON Schema)."
msgstr "Манифест {PATH} корректен (JSON Schema {SCHEMA})."

msgid "Manifest file not found at {PATH}."
msgstr "Файл манифеста не найден: {PATH}."

msgid "Manifest hook {PHASE} failed: {COMMAND}"
msgstr "Manifest hook {PHASE} завершился с ошибкой: {COMMAND}"

msgid "Manifest is already manifest_schema 2."
msgstr "Манифест уже использует manifest_schema 2."

msgid "Manifest requires odpm manager {REQUIRES} or newer; current manager is {ODPM_VERSION}."
msgstr "Manifest требует odpm менеджер {REQUIRES} или новее; текущий менеджер {ODPM_VERSION}."

msgid "Manifest root must be a JSON object."
msgstr "Корень манифеста должен быть JSON-объектом."

msgid "Nested odpm.json at {MANIFEST_PATH} declares odoo_version {NESTED_VERSION}, host project uses {HOST_VERSION}"
msgstr "Вложенный odpm.json ({MANIFEST_PATH}) задаёт odoo_version {NESTED_VERSION}, в host-проекте используется {HOST_VERSION}"

msgid "Nested odpm.json at {MANIFEST_PATH} declares python_version {NESTED_VERSION}, host project uses {HOST_VERSION}"
msgstr "Вложенный odpm.json ({MANIFEST_PATH}) задаёт python_version {NESTED_VERSION}, в host-проекте используется {HOST_VERSION}"

msgid "Nested {CONFIG_FILE_NAME} at {MANIFEST_PATH} must be a JSON object"
msgstr "Вложенный {CONFIG_FILE_NAME} ({MANIFEST_PATH}) должен быть JSON-объектом"

msgid "No PostgreSQL admin role is available for service {SERVICE}."
msgstr "Нет доступной административной роли PostgreSQL для сервиса {SERVICE}."

msgid "No database last_run snapshot yet; baseline will be adopted automatically on startup."
msgstr "Снимок last_run для БД ещё не создан; baseline будет принят автоматически при запуске."

msgid "No manifest changes to apply."
msgstr "Нет изменений манифеста для применения."

msgid "Non-interactive mode cannot prompt to download Odoo platform sources for the server scenario. Platform directory {odoo_src_dir} is missing odoo-bin. Pre-install platform sources, run odpm from an interactive terminal, or use ODPM_SCENARIO=developer for git-based clone during prepare."
msgstr "В неинтерактивном режиме нельзя запросить загрузку исходников platform для сценария server. В каталоге {odoo_src_dir} отсутствует odoo-bin. Установите исходники заранее, запустите odpm в интерактивном терминале или используйте ODPM_SCENARIO=developer для git-клонирования на этапе prepare."

msgid "Non-interactive mode requires an existing .env file in the project directory or under ~/.odpm/.env. Create it manually or set environment variables (BACKUP_DIR, ODOO_PROJECTS_DIR, PATH_TO_SSH_KEY, ODOO_PORT, POSTGRES_PORT, DEBUGGER_PORT, GEVENT_PORT, ODPM_SCENARIO, ODPM_LOCALE, ODPM_DEBUGGER_BACKEND, ODPM_IDE) before the first run."
msgstr "В неинтерактивном режиме нужен готовый файл .env в каталоге проекта или ~/.odpm/.env. Создайте его вручную или задайте переменные окружения (BACKUP_DIR, ODOO_PROJECTS_DIR, PATH_TO_SSH_KEY, ODOO_PORT, POSTGRES_PORT, DEBUGGER_PORT, GEVENT_PORT, ODPM_SCENARIO, ODPM_LOCALE, ODPM_DEBUGGER_BACKEND, ODPM_IDE) перед первым запуском."

msgid "Non-interactive mode requires odoo_version in the developing project's odpm.json or pass --odoo-version on the command line."
msgstr "В неинтерактивном режиме требуется odoo_version в odpm.json разрабатываемого проекта или параметр --odoo-version в командной строке."

msgid "ODPM scenario changed: {PREVIOUS} -> {CURRENT}."
msgstr "Сценарий ODPM изменился: {PREVIOUS} -> {CURRENT}."

msgid "ODPM scenario changed: {PREVIOUS} -> {CURRENT}.\nChoose: (a) abort  (c) continue\n"
msgstr "Сценарий ODPM изменился: {PREVIOUS} -> {CURRENT}.\nВыберите: (a) отмена  (c) продолжить\n"

msgid "Platform git repository at {odoo_src_dir} is not ready yet; cloning will run during prepare (git.materialize step)."
msgstr "Git-репозиторий platform в {odoo_src_dir} ещё не готов; клонирование выполнится на этапе prepare (шаг git.materialize)."

msgid "Please select scenario by number of odpm usage from this list {LIST_OF_SCENARIOS}\n Press 'Enter' to leave default value:\n"
msgstr "Пожалуйта выберите ценарий использования odpm из указанного списка {LIST_OF_SCENARIOS}\n Нажпите 'Enter' чтобы оставить значение по уполчнию:\n"

msgid "Please, enter odoo versions of this project. There is list of supported versions: {AVAILABEL_ODOO_VERSIONS_ARE}. You can leave default {ODOO_LATEST_VERSION} or write your own. Press 'Enter' to leave default value:\n"
msgstr "Пожалуйста, выберите версию Odoo для текущего проекта. Вот список поддерживаемых версий: {AVAILABEL_ODOO_VERSIONS_ARE}. Вы можете оставить значение по умолчанию {ODOO_LATEST_VERSION} или написать свою версию из списка. Нажмите 'Enter' чтобы оставить значение по умолчанию:\n"

msgid "PostgreSQL admin role did not become available within {SECONDS}s after bootstrap."
msgstr "Административная роль PostgreSQL не стала доступна за {SECONDS} с после bootstrap."

msgid "PostgreSQL application role {CURRENT} is missing in the running cluster."
msgstr "Роль приложения PostgreSQL {CURRENT} отсутствует в работающем кластере."

msgid "PostgreSQL application role {ROLE} is missing in the running cluster.\nChoose: (a) abort  (b) create role now\n"
msgstr "Роль приложения PostgreSQL {ROLE} отсутствует в работающем кластере.\nВыберите: (a) отмена  (b) создать роль сейчас\n"

msgid "PostgreSQL application role {ROLE} is ready."
msgstr "Роль приложения PostgreSQL {ROLE} готова."

msgid "PostgreSQL authentication failed for role {USER}"
msgstr "Ошибка аутентификации PostgreSQL для роли {USER}"

msgid "PostgreSQL compose service changed: {PREVIOUS} -> {CURRENT}."
msgstr "Имя сервиса PostgreSQL в compose изменилось: {PREVIOUS} -> {CURRENT}."

msgid "PostgreSQL connection failed: {DETAIL}"
msgstr "Не удалось подключиться к PostgreSQL: {DETAIL}"

msgid "PostgreSQL container running: {VALUE}"
msgstr "Контейнер PostgreSQL запущен: {VALUE}"

msgid "PostgreSQL container {SERVICE} is not running; start it before ensuring the role."
msgstr "Контейнер PostgreSQL {SERVICE} не запущен; запустите его перед созданием роли."

msgid "PostgreSQL credentials check failed after {ATTEMPTS} attempts"
msgstr "Проверка учётных данных PostgreSQL не удалась после {ATTEMPTS} попыток"

msgid "PostgreSQL credentials check timed out after {SECONDS}s for database {DBNAME}"
msgstr "Истекло время проверки учётных данных PostgreSQL ({SECONDS} с) для базы {DBNAME}"

msgid "PostgreSQL data directory changed:\n  previous: {PREVIOUS}\n  current: {CURRENT}\nChoose: (a) abort  (b) accept new data path  (c) show wipe instructions\n"
msgstr "Каталог данных PostgreSQL изменился:\n  было: {PREVIOUS}\n  стало: {CURRENT}\nВыберите: (a) отмена  (b) принять новый каталог  (c) инструкция по очистке\n"

msgid "PostgreSQL data directory changed: {PREVIOUS} -> {CURRENT}."
msgstr "Каталог данных PostgreSQL изменился: {PREVIOUS} -> {CURRENT}."

msgid "PostgreSQL data directory initialization state changed: {PREVIOUS} -> {CURRENT}."
msgstr "Состояние инициализации каталога данных PostgreSQL изменилось: {PREVIOUS} -> {CURRENT}."

msgid "PostgreSQL data directory initialization state changed: {PREVIOUS} -> {CURRENT}.\nChoose: (a) abort  (c) continue\n"
msgstr "Состояние инициализации каталога данных PostgreSQL изменилось: {PREVIOUS} -> {CURRENT}.\nВыберите: (a) отмена  (c) продолжить\n"

msgid "PostgreSQL host port changed: {PREVIOUS} -> {CURRENT}."
msgstr "Порт PostgreSQL на host изменился: {PREVIOUS} -> {CURRENT}."

msgid "PostgreSQL image version changed:\n  previous: {PREVIOUS}\n  current: {CURRENT}\nChoose: (a) abort  (b) accept and continue  (c) show wipe instructions\n"
msgstr "Версия образа PostgreSQL изменилась:\n  было: {PREVIOUS}\n  стало: {CURRENT}\nВыберите: (a) отмена  (b) принять и продолжить  (c) инструкция по очистке\n"

msgid "PostgreSQL image version changed: {PREVIOUS} -> {CURRENT}."
msgstr "Версия образа PostgreSQL изменилась: {PREVIOUS} -> {CURRENT}."

msgid "PostgreSQL in {SERVICE} is not ready yet; wait for startup before ensuring the role."
msgstr "PostgreSQL в {SERVICE} ещё не готов; дождитесь запуска перед созданием роли."

msgid "PostgreSQL is still starting up"
msgstr "PostgreSQL ещё запускается"

msgid "PostgreSQL ready: {VALUE}"
msgstr "PostgreSQL готов: {VALUE}"

msgid "PostgreSQL role {USER} does not exist"
msgstr "Роль PostgreSQL {USER} не существует"

msgid "PostgreSQL service {SERVICE} did not become ready within {SECONDS}s after single-user bootstrap."
msgstr "Сервис PostgreSQL {SERVICE} не стал готов за {SECONDS} с после single-user bootstrap."

msgid "PostgreSQL service {SERVICE} did not become ready within {SECONDS}s during baseline adoption."
msgstr "Сервис PostgreSQL {SERVICE} не стал готов за {SECONDS} с при принятии baseline."

msgid "PostgreSQL startup timeout exceeded"
msgstr "Превышено время ожидания запуска PostgreSQL"

msgid "Pre-commit file {PRE_COMMIT_FILE} was not found at {ODOO_PROJECT_DIR_PATH}"
msgstr "Pre-commit файл {PRE_COMMIT_FILE} не был найден в каталоге {ODOO_PROJECT_DIR_PATH}"

msgid "Preparing your Odoo environment (dependencies, templates, compose files)..."
msgstr "Подготовка окружения Odoo (зависимости, шаблоны, compose)..."

msgid "Project files are ready."
msgstr "Файлы проекта готовы."

msgid "Recorded database baseline snapshot at {PATH}."
msgstr "Записан снимок baseline БД: {PATH}."

msgid "Running with sudo/root privileges is not permitted."
msgstr "Запуск скрипта от root/sudo запрещен"

msgid "Select IDE configuration to generate (Enter for default {DEFAULT_IDE}):\n{OPTIONS}\n"
msgstr "Выберите конфигурацию IDE для генерации (Enter — по умолчанию {DEFAULT_IDE}):\n{OPTIONS}\n"

msgid "Select debugger backend for developer scenario (Enter for default {DEFAULT_BACKEND}):\n{OPTIONS}\n"
msgstr "Выберите backend отладчика для сценария developer (Enter — по умолчанию {DEFAULT_BACKEND}):\n{OPTIONS}\n"

msgid "Set IDE host name for pydevd_connect (container connects to Debug Server). Press 'Enter' for default {DEFAULT_HOST}:\n"
msgstr "Укажите имя хоста IDE для pydevd_connect (контейнер подключается к Debug Server). Нажмите 'Enter' для значения по умолчанию {DEFAULT_HOST}:\n"

msgid "Set PostgreSQL database server port which it will listen. You can leave default {DEFAULT_POSTGRES_PORT} or write your own. Press 'Enter' to leave default value:\n"
msgstr "Укажите порт, который будет слушать сервер PostgreSQL. Можете оставить значение по умолчанию {DEFAULT_POSTGRES_PORT} или укажите свой собственный. Нажмите 'Enter' чтобы оставить значение по умолчанию:\n"

msgid "Set debugger port which it will listen. You can leave default {DEFAULT_DEBUGGER_PORT} or write your own. Press 'Enter' to leave default value:\n"
msgstr "Укажите порт, который будет слушать сервер Отладчик. Можете оставить значение по умолчанию {DEFAULT_DEBUGGER_PORT} или укажите свой собственный. Нажмите 'Enter' чтобы оставить значение по умолчанию:\n"

msgid "Set directory for odoo creating/restoring backups, You can leave default {DEFAULT_ODOO_BACKUP_DIR} or write your own. Press 'Enter' to leave default value:"
msgstr "Укажите каталог создания/восстановления бэкапов odoo, Вы можете оставить значение по умолчанию {DEFAULT_ODOO_BACKUP_DIR} или написать ваше собственное. Нажмите 'Enter' чтобы оставить значение по умолчанию:"

msgid "Set gevent port which it will listen. You can leave default {DEFAULT_GEVENT_PORT} or write your own. Press 'Enter' to leave default value:\n"
msgstr "Укажите порт, который будет слушать сервер Gevent Websocket. Можете оставить значение по умолчанию {DEFAULT_GEVENT_PORT} или укажите свой собственный. Нажмите 'Enter' чтобы оставить значение по умолчанию:\n"

msgid "Set odoo port which it will listen. You can leave default {DEFAULT_ODOO_PORT} or write your own. Press 'Enter' to leave default value:\n"
msgstr "Укажите порт, который будет слушать odoo. Можете оставить значение по умолчанию {DEFAULT_ODOO_PORT} или укажите свой собственный. Нажмите 'Enter' чтобы оставить значение по умолчанию:\n"

msgid "Set odpm host message language. System locale is {SYSTEM_LOCALE}. Press 'Enter' to keep the system default or type a locale (for example ru_RU):"
msgstr "Укажите язык сообщений odpm на host. Локаль системы: {SYSTEM_LOCALE}. Нажмите 'Enter', чтобы оставить системную локаль, или введите локаль (например ru_RU):"

msgid "Set other odoo projects sources directory, You can leave default {DEFAULT_ODOO_PROJECTS_SRC_DIR} or write your own. Press 'Enter' to leave default value:"
msgstr "Укажите каталог хранения исходных текстов других проектов odoo, Вы можете оставить значение по умолчанию {DEFAULT_ODOO_PROJECTS_SRC_DIR} или написать ваше собственное. Нажмите 'Enter' чтобы оставить значение по умолчанию:"

msgid "Starting PostgreSQL service {SERVICE} for baseline adoption."
msgstr "Запуск сервиса PostgreSQL {SERVICE} для принятия baseline."

msgid "Starting containers with Docker Compose..."
msgstr "Запуск контейнеров через Docker Compose..."

msgid "Suspend Odoo until PyCharm Debug Server connects? Answer y/yes or n/no (Enter for no):\n"
msgstr "Приостанавливать Odoo до подключения PyCharm Debug Server? Ответьте y/yes или n/no (Enter — нет):\n"

msgid "Switching project {PROJECT_NAME} to branch {BRANCH_NAME}"
msgstr "Переключение проекта {PROJECT_NAME} на ветку {BRANCH_NAME}"

msgid "The {ODOO_GIT_LINK_PARAM} parameter can only be used together with the {INIT_PARAM} parameter"
msgstr "Параметр {ODOO_GIT_LINK_PARAM} может использоваться только совместно с параметром {INIT_PARAM}"

msgid "This dir is already {PROJECT_NAME} project"
msgstr "Данный каталог уже является {PROJECT_NAME} проектом"

msgid "This is not {PROJECT_NAME} directory. If you want to init new project use \"{PROJECT_NAME} {INIT_PARAM}\" command"
msgstr "Данный каталог не является odpm проектом. Если вы хотите создать новый проект, используйте команду '{PROJECT_NAME} {INIT_PARAM}'. "

msgid "To change PostgreSQL major version, stop containers, back up if needed, remove the data directory at {CURRENT}, then run odpm again so the cluster re-initializes."
msgstr "Чтобы сменить major-версию PostgreSQL, остановите контейнеры, при необходимости сделайте резервную копию, удалите каталог данных {CURRENT} и снова запустите odpm для переинициализации кластера."

msgid "To use a different PostgreSQL data directory, stop containers, move or remove the old data under {PREVIOUS}, then run odpm again. Current configured path: {CURRENT}."
msgstr "Чтобы использовать другой каталог данных PostgreSQL, остановите контейнеры, переместите или удалите старые данные в {PREVIOUS}, затем снова запустите odpm. Текущий настроенный путь: {CURRENT}."

msgid "Unexpected PostgreSQL connection error: {DETAIL}"
msgstr "Неожиданная ошибка подключения к PostgreSQL: {DETAIL}"

msgid "Unknown manifest hook plugin id: {PLUGIN_ID}"
msgstr "Неизвестный id плагина manifest hook: {PLUGIN_ID}"

msgid "Unsupported manifest_schema {SCHEMA}."
msgstr "Неподдерживаемый manifest_schema {SCHEMA}."

msgid "Unsupported manifest_schema {SCHEMA}; this manager supports manifest_schema up to {MAX_SCHEMA}."
msgstr "Неподдерживаемый manifest_schema {SCHEMA}; этот менеджер поддерживает manifest_schema до {MAX_SCHEMA}."

msgid "Unsupported odpm.json contract line {CONTRACT}; supported values are {SUPPORTED}."
msgstr "Неподдерживаемая строка контракта odpm.json {CONTRACT}; допустимые значения: {SUPPORTED}."

msgid "Updated PostgreSQL application role {ROLE}."
msgstr "Обновлена роль приложения PostgreSQL {ROLE}."

msgid "When Odoo is ready, open http://localhost:{ODOO_PORT}"
msgstr "Когда Odoo будет готов, откройте http://localhost:{ODOO_PORT}"

msgid "Wrote manifest v2 to {PATH}."
msgstr "Записан manifest v2 в {PATH}."

msgid "You do not set where developing project is situated. You can set it with --init command. Example: '--init file:///home/user/projects/your_directory_for_project' or directly form git repo --init https://github.com/aayartsev/odoo_demo_project.git'. You also can set it in user_settings.json file in key 'developing_project'"
msgstr "Вы не указали разрабатываемый проект. Вы можете указать это при использовании --init команды. Например: '--init file:///home/user/projects/your_directory_for_project' или напрямую из git репозитория --init https://github.com/aayartsev/odoo_demo_project.git'. Вы так же можете указать это в файле user_settings.json в ключе 'developing_project'"

msgid "You need to add your user {CURRENT_USER} to group {LINUX_DOCKER_GROUPNAME} run this command as root or sudo:  usermod -a -G {LINUX_DOCKER_GROUPNAME} {CURRENT_USER} then reboot your computer"
msgstr "Вам необходимо добавить пользователя {CURRENT_USER} в группу {LINUX_DOCKER_GROUPNAME}\n запустите следующую команду от имени root или с помощью sudo:  usermod -a -G {LINUX_DOCKER_GROUPNAME} {CURRENT_USER}\n Затем перезапустите ваш компьютер"

msgid "You need to have free space more than {NECESSARY_FREE_SPACE} in {DIR_FOR_FREE_SPACE} directory"
msgstr "В каталоге {DIR_FOR_FREE_SPACE} должно быть больше чем {NECESSARY_FREE_SPACE} свободного места"

msgid "You select this odoo backups dir: {SELECTED_ODOO_BACKUPS_DIR}\n"
msgstr "Вы выбрали следующий каталог для использования бэкапов odoo: {SELECTED_ODOO_BACKUPS_DIR}\n"

msgid "You select this odoo version: {SELECTED_ODOO_VERSION}\n"
msgstr "Вы выбрали следующую версию odoo: {SELECTED_ODOO_VERSION}\n"

msgid "You select this other odoo projects sources dir: {SELECTED_ODOO_PROJECTS_DIR}\n"
msgstr "Вы выбрали следующий каталог для хранения исходных текстов других odoo проектов: {SELECTED_ODOO_PROJECTS_DIR}\n"

msgid "You select this port for which Odoo Gevent Websocket System will listen: {SELECTED_GEVENT_PORT}\n"
msgstr "Вы выбрали следующий порт, который будет слушать Odoo Gevent Websocket System: {SELECTED_GEVENT_PORT}\n"

msgid "You select this port for which PostgreSQL database server will listen: {SELECTED_POSTGRES_PORT}\n"
msgstr "Вы выбрали следующий порт, который будет слушать сервер PostgreSQL: {SELECTED_POSTGRES_PORT}\n"

msgid "You select this port for which Python Debugger will listen: {SELECTED_DEBUGGER_PORT}\n"
msgstr "Вы выбрали следующий порт, который будет слушать Python Debugger: {SELECTED_DEBUGGER_PORT}\n"

msgid "You select this port for which odoo will listen: {SELECTED_ODOO_PORT}\n"
msgstr "Вы выбрали следующий порт, который будет слушать odoo: {SELECTED_ODOO_PORT}\n"

msgid "You select {SELECTED_ODPM_SCENARIO} scenario  for odpm usage\n"
msgstr "Вы выбрали ценарий {SELECTED_ODPM_SCENARIO} для использования odpm\n"

msgid "You selected IDE configuration: {SELECTED_IDE}\n"
msgstr "Вы выбрали конфигурацию IDE: {SELECTED_IDE}\n"

msgid "You selected debugger backend: {SELECTED_BACKEND}\n"
msgstr "Вы выбрали backend отладчика: {SELECTED_BACKEND}\n"

msgid "You selected debugger connect host: {SELECTED_HOST}\n"
msgstr "Вы выбрали хост подключения отладчика: {SELECTED_HOST}\n"

msgid "You selected debugger suspend on connect: {SELECTED_SUSPEND}\n"
msgstr "Вы выбрали приостановку при подключении отладчика: {SELECTED_SUSPEND}\n"

msgid "You selected the system default locale for odpm messages: {SELECTED_LOCALE}\n"
msgstr "Вы выбрали системную локаль по умолчанию для сообщений odpm: {SELECTED_LOCALE}\n"

msgid "You selected this locale for odpm messages: {SELECTED_LOCALE}\n"
msgstr "Вы выбрали следующую локаль для сообщений odpm: {SELECTED_LOCALE}\n"

msgid "Your odoo src directory {odoo_src_dir} is not git repository.Please fix it, or delete and clone its repo again: git clone https://github.com/odoo/odoo.git"
msgstr "Указанный вами каталог с исходными текстами odoo {odoo_src_dir} не является git репозиторием или репозиторий поврежденПожалуйста исправьте повреждения или клонируйте репозиторий заново: git clone https://github.com/odoo/odoo.git"

msgid "database configuration drift detected: {KINDS}"
msgstr "Обнаружен дрейф конфигурации БД: {KINDS}"

msgid "database configuration matches last_run snapshot"
msgstr "Конфигурация БД совпадает со снимком last_run"

msgid "database subcommand required: use \"odpm database status\" or \"odpm database ensure-role\"."
msgstr "Укажите подкоманду database: \"odpm database status\" или \"odpm database ensure-role\"."

msgid "docker build failed with exit code {EXIT_CODE}"
msgstr "docker build завершился с кодом {EXIT_CODE}"

msgid "docker compose up failed with exit code {EXIT_CODE}"
msgstr "docker compose up завершился с кодом {EXIT_CODE}"

msgid "first database run (no last_run snapshot yet)"
msgstr "Первый запуск БД (снимок last_run ещё не создан)"

msgid "manifest locks.git vs deps.lock.json differ: {DETAIL}"
msgstr "locks.git в manifest и deps.lock.json расходятся: {DETAIL}"

msgid "manifest subcommand required: use \"odpm manifest migrate\" or \"odpm manifest validate\"."
msgstr "Укажите подкоманду manifest: \"odpm manifest migrate\" или \"odpm manifest validate\"."

msgid "manifest_schema 2 requires requires_odpm (minimum odpm manager version)."
msgstr "manifest_schema 2 требует поле requires_odpm (минимальная версия менеджера odpm)."

msgid "odoo.conf db_host ({CURRENT}) does not match postgres service name ({PREVIOUS})."
msgstr "В odoo.conf db_host ({CURRENT}) не совпадает с именем сервиса postgres ({PREVIOUS})."

msgid "odoo.conf db_host out of sync with postgres service ({EXPECTED})"
msgstr "В odoo.conf db_host не синхронизирован с сервисом postgres ({EXPECTED})"

msgid "odoo.conf db_host: {HOST}"
msgstr "odoo.conf db_host: {HOST}"

msgid "psycopg2 is required."
msgstr "Требуется psycopg2."

msgid "running command: → git {GIT_ARGS} for {PROJECT}"
msgstr "Выполняется команда: → git {GIT_ARGS} для {PROJECT}"
