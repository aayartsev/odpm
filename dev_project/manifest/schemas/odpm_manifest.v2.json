{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odpm://schemas/odpm_manifest.v2.json",
  "title": "odpm.json manifest v2 (nested)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema",
    "requires_odpm",
    "platform",
    "python",
    "distro",
    "postgres"
  ],
  "properties": {
    "manifest_schema": {
      "type": "integer",
      "const": 2
    },
    "requires_odpm": {
      "type": "string",
      "minLength": 1
    },
    "odoo_version": {
      "type": ["string", "number"]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git"],
      "properties": {
        "git": { "type": "string", "minLength": 1 },
        "build_date": { "type": "string" }
      }
    },
    "python": { "type": "string", "minLength": 1 },
    "distro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "postgres": { "type": "string", "minLength": 1 },
    "dependencies": {
      "$ref": "#/$defs/stringList"
    },
    "requirements": {
      "$ref": "#/$defs/stringList"
    },
    "developing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": { "type": "string", "minLength": 1 }
      }
    },
    "platform_name": { "type": "string" },
    "arch": { "type": "string" },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "venv": { "type": "string" }
      }
    },
    "hooks": {
      "$ref": "#/$defs/manifestHooks"
    },
    "services": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/composeService" }
    },
    "service_patches": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/composeServicePatch" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "country": { "type": ["string", "null", "boolean"] }
      }
    },
    "odoo_conf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "secrets": {
      "$ref": "#/$defs/manifestSecrets"
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "developer": { "$ref": "#/$defs/scenarioOverlay" },
        "server": { "$ref": "#/$defs/scenarioOverlay" },
        "ci": { "$ref": "#/$defs/scenarioOverlay" }
      }
    }
  },
  "$defs": {
    "scenarioOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "odoo_conf": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/composeService" }
        },
        "service_patches": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/composeServicePatch" }
        },
        "requirements": {
          "$ref": "#/$defs/stringList"
        },
        "dependencies": {
          "$ref": "#/$defs/stringList"
        },
        "hooks": {
          "$ref": "#/$defs/manifestHooks"
        },
        "secrets": {
          "$ref": "#/$defs/manifestSecrets"
        }
      }
    },
    "manifestSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "keys": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hookCommandEntry": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        { "type": "string", "minLength": 1 }
      ]
    },
    "manifestHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post_clone": {
          "type": "array",
          "items": { "$ref": "#/$defs/hookCommandEntry" }
        },
        "post_prepare": {
          "type": "array",
          "items": { "$ref": "#/$defs/hookCommandEntry" }
        },
        "pre_up": {
          "type": "array",
          "items": { "$ref": "#/$defs/hookCommandEntry" }
        }
      }
    },
    "composeService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "volumes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "networks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "restart": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "user": { "type": "string", "minLength": 1 },
        "tty": { "type": "boolean" }
      }
    },
    "composeServicePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "volumes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "networks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "restart": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "user": { "type": "string", "minLength": 1 },
        "tty": { "type": "boolean" }
      }
    }
  }
}
