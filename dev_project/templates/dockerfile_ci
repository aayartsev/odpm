# #MESSAGE#
FROM {BASE_IMAGE}

WORKDIR {DOCKER_PROJECT_DIR}

COPY --chown={CONTAINER_USER}:{CONTAINER_USER} . .

USER root
RUN mkdir -p /run/odpm && chown {CONTAINER_USER}:{CONTAINER_USER} /run/odpm

COPY --chown={CONTAINER_USER}:{CONTAINER_USER} {CI_RUNTIME_CONFIG_CONTEXT_REL} {ODPM_RUNTIME_CONFIG_CONTAINER_PATH}

ENV {ODPM_CONFIG_PATH_ENV}={ODPM_RUNTIME_CONFIG_CONTAINER_PATH}

{CI_SECRETS_DOCKERFILE_BLOCK}USER {CONTAINER_USER}

RUN python3 -m dev_project.bake_venv --config {CI_VENV_INSTALL_JSON}
