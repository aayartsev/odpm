# Lint layer: FROM platform; bake pre-commit hooks; no developing tree.
# COPY lines for config / hooks / bake_pre_commit.py are injected by ensure_lint.
ARG PLATFORM_IMAGE
FROM ${PLATFORM_IMAGE}

ARG CONTAINER_USER=odoo

USER root
RUN python3 -m pip install --no-cache-dir 'pre-commit>=3,<5'

WORKDIR /home/odoo

USER ${CONTAINER_USER}
RUN python3 -m dev_project.bake_pre_commit
